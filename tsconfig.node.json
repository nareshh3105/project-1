{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "./node_modules/.tmp/tsconfig-node",
    "types": ["node"]
  },
  "include": [
    "electron.vite.config.ts",
    "vite.config.ts",
    "tailwind.config.ts",
    "electron/**/*.ts"
  ]
}
